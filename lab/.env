# Addressing, images and CPU plan of the lab. Docker Compose reads this file
# to fill the ${...} references in etcd.yml and redis.yml, and the scripts in
# scripts/ load it too. A variable already set in the shell takes precedence.

# First three octets of the two /24 networks. Nodes are .11, .12 and .13, and
# the generator is .100 on the client network. The lab handout uses 172.20.0
# and 172.21.0; those ranges were taken on the measurement host.
LAB_NET_CLUSTER=172.30.0
LAB_NET_CLIENTS=172.31.0

ETCD_IMAGE=quay.io/coreos/etcd:v3.5.14
REDIS_IMAGE=redis:7.4.11
NETSHOOT_IMAGE=nicolaka/netshoot

# Logical CPUs each container may use (cpuset). The values below give each
# node one physical P-core of an i7-13620H and leave three P-cores and the
# four E-cores to the generator. Leave a value empty to remove the limit.
LAB_CPUS_N1=0,1
LAB_CPUS_N2=2,3
LAB_CPUS_N3=8,9
LAB_CPUS_GEN=4-7,10-15

# User that owns the files written to results/. The scripts replace these
# with the id of whoever runs them.
LAB_UID=1000
LAB_GID=1000
